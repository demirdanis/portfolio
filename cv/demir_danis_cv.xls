<html xmlns:o="urn:schemas-microsoft-com:office:office"
xmlns:x="urn:schemas-microsoft-com:office:excel"
xmlns="http://www.w3.org/TR/REC-html40">
<head>
<meta charset="UTF-8">
<!--[if gte mso 9]>
<xml>
 <x:ExcelWorkbook>
  <x:ExcelWorksheets>
   <x:ExcelWorksheet>
    <x:Name>CV</x:Name>
    <x:WorksheetOptions>
     <x:DisplayGridlines/>
    </x:WorksheetOptions>
   </x:ExcelWorksheet>
  </x:ExcelWorksheets>
 </x:ExcelWorkbook>
</xml>
<![endif]-->
<style>
  body { font-family: Calibri, Arial, sans-serif; }
  table { border-collapse: collapse; width: 900px; }
  td { padding: 6px 10px; vertical-align: top; }

  .name {
    background-color: #1F3864;
    color: #ffffff;
    font-size: 22pt;
    font-weight: bold;
    text-align: center;
    padding: 16px;
  }
  .title-row {
    background-color: #2E75B6;
    color: #ffffff;
    font-size: 13pt;
    font-weight: bold;
    text-align: center;
    padding: 8px;
  }
  .contact-row {
    background-color: #D6E4F0;
    color: #1F3864;
    font-size: 9pt;
    text-align: center;
    padding: 6px;
  }
  .section-header {
    background-color: #1F3864;
    color: #ffffff;
    font-size: 11pt;
    font-weight: bold;
    padding: 7px 10px;
  }
  .summary-cell {
    background-color: #F2F2F2;
    font-size: 10pt;
    padding: 10px;
  }
  .skill-label {
    background-color: #1F3864;
    color: #ffffff;
    font-size: 10pt;
    font-weight: bold;
    width: 180px;
    padding: 6px 10px;
  }
  .skill-value-gray {
    background-color: #F2F2F2;
    font-size: 10pt;
    padding: 6px 10px;
  }
  .skill-value-white {
    background-color: #ffffff;
    font-size: 10pt;
    padding: 6px 10px;
  }
  .job-header {
    background-color: #D6E4F0;
    color: #1F3864;
    font-size: 10pt;
    font-weight: bold;
    padding: 7px 10px;
  }
  .bullet-gray {
    background-color: #F2F2F2;
    font-size: 9.5pt;
    padding: 5px 10px;
  }
  .bullet-white {
    background-color: #ffffff;
    font-size: 9.5pt;
    padding: 5px 10px;
  }
  .edu-cell {
    background-color: #F2F2F2;
    font-size: 10pt;
    padding: 8px 10px;
  }
  .cert-cell {
    background-color: #F2F2F2;
    font-size: 10pt;
    padding: 6px 10px;
  }
  .spacer { height: 8px; background-color: #ffffff; }
</style>
</head>
<body>
<table>

  <!-- NAME -->
  <tr><td colspan="2" class="name">Demir Danış</td></tr>
  <tr><td colspan="2" class="title-row">Software Engineering Manager &amp; Full-Stack Engineer</td></tr>
  <tr><td colspan="2" class="contact-row">
    📞 +90 506 107 84 77 &nbsp;|&nbsp; ✉️ danis.demir@gmail.com &nbsp;|&nbsp;
    🌐 demirdanis.dev &nbsp;|&nbsp; linkedin.com/in/demir-danis &nbsp;|&nbsp; github.com/demirdanis
  </td></tr>

  <!-- SPACER -->
  <tr><td colspan="2" class="spacer"></td></tr>

  <!-- SUMMARY -->
  <tr><td colspan="2" class="section-header">  SUMMARY</td></tr>
  <tr><td colspan="2" class="summary-cell">
    Experienced Full-Stack Engineer &amp; Engineering Manager with 13+ years of hands-on experience building large-scale, production-grade systems across web and mobile platforms.
    Strong expertise in microservice architectures, micro frontends, and Progressive Web Apps. Currently leading a 7-person full-stack team at Brew Interactive delivering global-scale products.
    Passionate about scalable system design, code quality, and delivering high-impact products at speed.
  </td></tr>

  <!-- SPACER -->
  <tr><td colspan="2" class="spacer"></td></tr>

  <!-- CORE COMPETENCIES -->
  <tr><td colspan="2" class="section-header">  CORE COMPETENCIES</td></tr>
  <tr><td class="skill-label">Leadership</td><td class="skill-value-gray">Team Lead, Agile/Scrum, Code Review Culture, Mentoring</td></tr>
  <tr><td class="skill-label">Frontend</td><td class="skill-value-white">React, Next.js, Vue.js, Angular, PWA, Micro Frontend</td></tr>
  <tr><td class="skill-label">Backend</td><td class="skill-value-gray">.NET Core, Node.js, NestJS, Go</td></tr>
  <tr><td class="skill-label">Mobile</td><td class="skill-value-white">React Native, Kotlin (Android), Swift (iOS)</td></tr>
  <tr><td class="skill-label">Databases</td><td class="skill-value-gray">MongoDB, PostgreSQL, MySQL, SQLite, Redis</td></tr>
  <tr><td class="skill-label">Search</td><td class="skill-value-white">Elasticsearch — index design, advanced queries, low-latency</td></tr>
  <tr><td class="skill-label">DevOps &amp; Cloud</td><td class="skill-value-gray">Docker, Kubernetes, CI/CD, AWS, Nginx, Cloudflare</td></tr>
  <tr><td class="skill-label">Messaging &amp; Streaming</td><td class="skill-value-white">RabbitMQ, WebRTC, FFmpeg, RTMP, Centrifugo</td></tr>
  <tr><td class="skill-label">API &amp; Gateway</td><td class="skill-value-gray">Hasura, REST, GraphQL</td></tr>

  <!-- SPACER -->
  <tr><td colspan="2" class="spacer"></td></tr>

  <!-- EXPERIENCE -->
  <tr><td colspan="2" class="section-header">  PROFESSIONAL EXPERIENCE</td></tr>

  <!-- Job 1 -->
  <tr><td colspan="2" class="job-header">Full Stack Engineer &amp; Team Lead &nbsp;|&nbsp; Brew Interactive — Remote &nbsp;|&nbsp; 2021 – Present</td></tr>
  <tr><td colspan="2" class="bullet-gray">• Leading a 7-person full-stack team (~80% IC / ~20% leadership) on global-scale products</td></tr>
  <tr><td colspan="2" class="bullet-white">• Designed microservice architectures with .NET Core &amp; NestJS; integrated Hasura as API gateway for rapid, reliable backend delivery</td></tr>
  <tr><td colspan="2" class="bullet-gray">• Built high-performance Elasticsearch infrastructure with optimized index design &amp; advanced query strategies — low-latency search across complex datasets</td></tr>
  <tr><td colspan="2" class="bullet-white">• Deployed horizontally scalable, highly available systems on Kubernetes</td></tr>
  <tr><td colspan="2" class="bullet-gray">• Delivered full-stack features across React, Next.js, Vue.js, Angular — selected per project requirements. Documented atomic components with Storybook</td></tr>
  <tr><td colspan="2" class="bullet-white">• Contributed to production mobile apps with React Native, Swift, and Kotlin</td></tr>
  <tr><td colspan="2" class="bullet-gray">• Notable projects: villasepeti.com, Bilyoner, Nesy/Aras Kargo, enuygunfinans.com, TomorrowID (face recognition), Shubuo (LED integrations), KoçSistem, KoçDigital</td></tr>

  <!-- spacer between jobs -->
  <tr><td colspan="2" style="height:5px;"></td></tr>

  <!-- Job 2 -->
  <tr><td colspan="2" class="job-header">Senior Full-Stack Software Engineer &nbsp;|&nbsp; Veriyaz Yazılım — Remote &nbsp;|&nbsp; June 2016 – April 2021</td></tr>
  <tr><td colspan="2" class="bullet-gray">• PTT Trade (Turkey's B2B marketplace, comparable to Alibaba): developed real-time messaging, video streaming infrastructure, and scalable service layers for a high-traffic platform</td></tr>
  <tr><td colspan="2" class="bullet-white">• Seslidunya.com: sole developer of a real-time audio/video chat platform with 1-on-1, group &amp; room modes, screen sharing, and remote desktop control. Shipped web + Android + iOS — still in active use</td></tr>
  <tr><td colspan="2" class="bullet-gray">• Tech: .NET Core, Go, MongoDB, Redis, Elasticsearch, RabbitMQ, Kubernetes, Docker, WebRTC, FFmpeg, RTMP, Angular, Ionic/Capacitor, Centrifugo</td></tr>

  <tr><td colspan="2" style="height:5px;"></td></tr>

  <!-- Job 3 -->
  <tr><td colspan="2" class="job-header">Full-Stack Software Engineer &nbsp;|&nbsp; Alangoya Bilgi Teknolojileri &nbsp;|&nbsp; June 2015 – June 2016</td></tr>
  <tr><td colspan="2" class="bullet-gray">• Built dynamic reporting &amp; analytics web app for Turkish Sugar Factories (Türkiye Şeker Fabrikaları)</td></tr>
  <tr><td colspan="2" class="bullet-white">• Tech: .NET, MSSQL, Redis, Angular, CAdES Digital Signature, Mobile Signing</td></tr>

  <tr><td colspan="2" style="height:5px;"></td></tr>

  <!-- Job 4 -->
  <tr><td colspan="2" class="job-header">Full-Stack Developer (R&amp;D) &nbsp;|&nbsp; Akıllı Sistemler Bilişim &nbsp;|&nbsp; May 2013 – June 2015</td></tr>
  <tr><td colspan="2" class="bullet-gray">• TÜBİTAK-funded R&amp;D projects: audio/video processing, document crawling, custom search engine development</td></tr>
  <tr><td colspan="2" class="bullet-white">• Tech: C#, .NET, jQuery, HTML/CSS, NoSQL</td></tr>

  <tr><td colspan="2" style="height:5px;"></td></tr>

  <!-- Job 5 -->
  <tr><td colspan="2" class="job-header">Web Developer &nbsp;|&nbsp; İdeal Web Tasarım — İzmir &nbsp;|&nbsp; July 2011 – May 2013</td></tr>
  <tr><td colspan="2" class="bullet-gray">• Sole developer responsible for 50+ corporate websites, web applications, order management systems, and admin panels. Covered frontend, backend, and UI/UX</td></tr>

  <!-- SPACER -->
  <tr><td colspan="2" class="spacer"></td></tr>

  <!-- EDUCATION -->
  <tr><td colspan="2" class="section-header">  EDUCATION</td></tr>
  <tr><td colspan="2" class="edu-cell">🎓 B.Sc. Computer Engineering &nbsp;|&nbsp; Ege University, İzmir &nbsp;|&nbsp; 2011</td></tr>

  <!-- SPACER -->
  <tr><td colspan="2" class="spacer"></td></tr>

  <!-- CERTIFICATIONS -->
  <tr><td colspan="2" class="section-header">  CERTIFICATIONS &amp; TRAINING</td></tr>
  <tr><td colspan="2" class="cert-cell">✔  Leadership Development Program</td></tr>
  <tr><td colspan="2" class="cert-cell">✔  Management &amp; Team Leadership Training</td></tr>

</table>
</body>
</html>
